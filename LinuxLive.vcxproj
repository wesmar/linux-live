    <ClCompile Include="src\efi\Efi.cpp" />
    <ClCompile Include="src\gui\Dialogs.cpp" />
    <ClCompile Include="src\gui\MainWindow.cpp" />
    <ClCompile Include="src\gui\MainWindowCommands.cpp" />
    <ClCompile Include="src\gui\MainWindowLayout.cpp" />
    <ClCompile Include="src\gui\MainWindowMenus.cpp" />
    <ClCompile Include="src\gui\MainWindowState.cpp" />
    <ClCompile Include="src\gui\Menus.cpp" />
    <ClCompile Include="src\gui\Theme.cpp" />
    <ClCompile Include="src\gui\Widgets.cpp" />
    <ClCompile Include="src\install\EspInstaller.cpp" />
    <ClCompile Include="src\install\Layout.cpp" />
