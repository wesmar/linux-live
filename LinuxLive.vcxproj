    <CopyFileToFolders Include="src\resources\language\ja.lng"><DestinationFolders>$(OutDir)language</DestinationFolders></CopyFileToFolders>
    <CopyFileToFolders Include="src\resources\language\pl.lng"><DestinationFolders>$(OutDir)language</DestinationFolders></CopyFileToFolders>
