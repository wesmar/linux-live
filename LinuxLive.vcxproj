    <ClInclude Include="src\support\Wmi.h" />
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="src\resources\app.rc" />
  </ItemGroup>
  <ItemGroup>
    <None Include="src\resources\lang\en.rc" />
