# Linux Live - Korean language file (한국어).
# Format: ID=text, UTF-8, escapes \n \r \t \\ ; keep every {...} placeholder.
# English, the reference, is built into LinuxLive.exe ("LinuxLive.exe lng-export en.lng").
#name=한국어
#locale=ko

